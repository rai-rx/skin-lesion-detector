# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend API URL (must be accessible from Vercel)
# In production, this should point to your deployed backend
# Examples: https://your-backend.railway.app, https://your-backend.render.com, etc.
VITE_API_URL=https://your-backend-url.com

# Backend environment variables (if running backend on Vercel)
DATABASE_URL=your-postgres-url
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
JWT_SECRET=your-jwt-secret
STORAGE_BUCKET=your-storage-bucket
